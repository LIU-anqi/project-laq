# ============================================
# 编译生成的文件（不同平台）
# ============================================
# Windows
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.obj
*.o
*.a
*.so
*.dylib

# 编译输出目录（VS 默认）
bin/
obj/
Debug/
Release/
x64/
x86/
ARM/
ARM64/
build/
cmake-build-*/

# ============================================
# CMake 相关
# ============================================
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# ============================================
# 常见 IDE 配置
# ============================================
# VS Code
.vscode/
*.code-workspace

# CLion
.idea/
*.iml
*.iws

# ============================================
# 日志、临时文件、备份
# ============================================
# 注意：*.log 会忽略所有 .log 文件，如果你有重要的 .log 要保留，
# 请用 !important.log 单独解除，或把重要日志改成 .txt
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.orig

# ============================================
# 包管理器 & 依赖
# ============================================
# vcpkg 构建缓存（如果你用 vcpkg）
vcpkg_installed/
# 第三方库源码（通常单独管理）
third_party/*/build/

# ============================================
# 操作系统垃圾文件
# ============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ============================================
# 项目特定：大模型/结果文件（不上传）
# ============================================
# PyTorch 模型文件（体积大）
*.pth
*.pt

# 医学图像结果（体积大）
*.nii.gz

# ============================================
# 项目特定：.kiro 临时输出（保留 docs，只忽略临时文件）
# ============================================
.kiro/tools/_*.txt
.kiro/tools/_*.json
.kiro/poc/*/build-*/